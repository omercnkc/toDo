# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env repoya eklenmez.
# Şifrelerde tırnak ve ters bölü kullanmayın (init.sh SQL içine yerleştirir).

# --- MySQL ---
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root
AUTH_DB_PASSWORD=change-me-auth
PROJECT_DB_PASSWORD=change-me-project
TASK_DB_PASSWORD=change-me-task

# --- Güvenlik ---
# HS256 için en az 32 bayt (örn. `openssl rand -base64 48`)
JWT_SECRET=change-me-at-least-32-bytes-long-secret-value
# Yerel http geliştirmede false, https ortamlarında true
COOKIE_SECURE=false

# --- Gateway ---
# CORS'a izin verilen tek origin (frontend normalde aynı origin'den gelir; bu yalnızca yedek)
FRONTEND_ORIGIN=http://localhost:4200

# --- Varsayılan ADMIN (auth-service ilk açılışta oluşturur) ---
ADMIN_EMAIL=admin@todo.local
ADMIN_PASSWORD=change-me-admin
